{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/acp1_2_hypothesis_catalog_schema.json",
  "title": "cost-necessity-hypothesis-catalog-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "schema_id", "generator_version", "source_and_scope",
    "candidate_generation_policy", "catalog_status", "hypothesis_candidates",
    "candidate_summary", "unknowns", "traceability", "policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema_id": {"const": "cost-necessity-hypothesis-catalog-v1"},
    "generator_version": {"const": "acp-hypothesis-catalog-v0.1"},
    "source_and_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribution_sha256", "repeated_evidence_analysis_sha256", "catalog_scope", "intervention_executed"],
      "properties": {
        "attribution_sha256": {"$ref": "#/$defs/hash"},
        "repeated_evidence_analysis_sha256": {"$ref": "#/$defs/hash"},
        "catalog_scope": {"const": "offline_experiment_candidate_generation"},
        "intervention_executed": {"const": false}
      }
    },
    "candidate_generation_policy": {"type": "object"},
    "catalog_status": {"enum": ["candidates_present", "empty_no_preregistered_trigger"]},
    "hypothesis_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id", "hypothesis_type", "target_scope", "target_call_ids",
          "observed_exposure_tokens", "observed_share", "factual_basis",
          "necessity_status", "causal_status", "candidate_status",
          "required_validation", "validation_feasibility", "source_refs"
        ],
        "properties": {
          "hypothesis_id": {"$ref": "#/$defs/hash"},
          "hypothesis_type": {"enum": ["high_cost_call_candidate", "cost_concentration_candidate", "repeated_or_overlapping_evidence_candidate"]},
          "target_scope": {"enum": ["call", "catalog"]},
          "target_call_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
          "observed_exposure_tokens": {"type": "integer", "minimum": 0},
          "observed_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "factual_basis": {"type": "object"},
          "necessity_status": {"const": "unknown"},
          "causal_status": {"const": "untested"},
          "candidate_status": {"const": "eligible_for_future_controlled_validation"},
          "required_validation": {
            "type": "array",
            "prefixItems": [
              {"const": "construct_isolated_paired_task_replay"},
              {"const": "apply_controlled_evidence_intervention_in_experimental_harness"},
              {"const": "compare_correctness"},
              {"const": "compare_tool_path_and_model_cycles"},
              {"const": "estimate_delta_only_if_correctness_is_preserved"}
            ],
            "items": false,
            "minItems": 5,
            "maxItems": 5
          },
          "validation_feasibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reason_codes"],
            "properties": {
              "status": {"const": "blocked"},
              "reason_codes": {
                "const": ["missing_controlled_intervention_interface", "missing_replayable_task_context"]
              }
            }
          },
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        }
      }
    },
    "candidate_summary": {"type": "object"},
    "unknowns": {"type": "object"},
    "traceability": {"type": "array", "items": {"type": "object"}},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_grounded_candidates_only", "necessity_verdict_produced", "causal_claim_produced",
        "avoidable_or_savings_estimate_produced", "agent_recommendation_produced",
        "intervention_executed", "online_effect", "canonical_fact_source"
      ],
      "properties": {
        "fact_grounded_candidates_only": {"const": true},
        "necessity_verdict_produced": {"const": false},
        "causal_claim_produced": {"const": false},
        "avoidable_or_savings_estimate_produced": {"const": false},
        "agent_recommendation_produced": {"const": false},
        "intervention_executed": {"const": false},
        "online_effect": {"const": false},
        "canonical_fact_source": {"const": "json"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
