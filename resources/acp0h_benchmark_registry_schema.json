{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acp-benchmark-registry-v1",
  "title": "ACP governed benchmark registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "schema_id", "registry_version", "frozen_at", "subject_commit",
    "source_fixture", "governance_policy", "cases", "formal_baseline_inputs"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {"enum": ["stable_gate", "stochastic_diagnostic", "coverage_probe", "failure_injection"]},
    "gate": {"enum": ["absolute_correctness", "distribution_parity", "cost_neutrality", "path_neutrality", "host_transparency", "collector_coverage"]}
  },
  "properties": {
    "schema_version": {"const": 1},
    "schema_id": {"const": "acp-benchmark-registry-v1"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "frozen_at": {"type": "string", "format": "date"},
    "subject_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "source_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "fixture_id"],
      "properties": {
        "path": {"const": "resources/acp0_4_cases.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "fixture_id": {"const": "acp0-4-natural-paired-v1"}
      }
    },
    "governance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id", "new_case_workflow", "new_stable_minimum_repetitions",
        "new_stable_minimum_correct", "stochastic_requires_preregistered_parity",
        "historical_cases_are_never_deleted", "migration_exception"
      ],
      "properties": {
        "policy_id": {"const": "acp-benchmark-governance-v1"},
        "new_case_workflow": {
          "const": ["ground_truth_audit", "native_calibration", "classification", "registry_freeze", "suite_admission"]
        },
        "new_stable_minimum_repetitions": {"const": 20},
        "new_stable_minimum_correct": {"const": 19},
        "stochastic_requires_preregistered_parity": {"const": true},
        "historical_cases_are_never_deleted": {"const": true},
        "migration_exception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "minimum_repetitions", "requires_perfect_native_record", "applies_only_to_registry_version"],
          "properties": {
            "basis": {"const": "frozen_acp0_4a_historical_migration"},
            "minimum_repetitions": {"const": 5},
            "requires_perfect_native_record": {"const": true},
            "applies_only_to_registry_version": {"const": "1.0.0"}
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id", "version", "purpose", "benchmark_role", "ground_truth",
          "native_calibration", "admission_status", "introduced_at", "supersedes",
          "retired_reason", "oracle_and_scorer_version", "expected_coverage_path",
          "allowed_gate_usage"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "version": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 1},
          "benchmark_role": {"$ref": "#/$defs/role"},
          "ground_truth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["audit_status", "source_pointer", "question_sha256", "expected_answer_sha256"],
            "properties": {
              "audit_status": {"enum": ["migrated_frozen", "audited_unambiguous", "pending"]},
              "source_pointer": {"type": "string", "pattern": "^resources/acp0_4_cases.json#/cases/[0-9]+$"},
              "question_sha256": {"$ref": "#/$defs/sha256"},
              "expected_answer_sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "native_calibration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "basis", "repetitions", "correct", "evidence_path", "evidence_sha256"],
            "properties": {
              "status": {"enum": ["qualified_stable", "qualified_stochastic", "not_qualified"]},
              "basis": {"enum": ["historical_migration", "prospective_native_calibration", "none"]},
              "repetitions": {"type": "integer", "minimum": 0},
              "correct": {"type": "integer", "minimum": 0},
              "evidence_path": {"type": ["string", "null"]},
              "evidence_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
            }
          },
          "admission_status": {"enum": ["active", "diagnostic_only", "retired_but_preserved", "pending"]},
          "introduced_at": {"type": "string", "format": "date"},
          "supersedes": {"type": ["string", "null"]},
          "retired_reason": {"type": ["string", "null"]},
          "oracle_and_scorer_version": {"const": "strip-outer-whitespace-exact-final-text-v1"},
          "expected_coverage_path": {"enum": ["local_tool_evidence", "tool_failure_evidence", "collector_failure_evidence"]},
          "allowed_gate_usage": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/gate"}}
        }
      }
    },
    "formal_baseline_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id", "version", "purpose", "benchmark_role", "fixture_path", "fixture_sha256",
          "qualification_status", "admission_status", "expected_coverage_status", "introduced_at",
          "supersedes", "retired_reason"
        ],
        "properties": {
          "input_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "version": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 1},
          "benchmark_role": {"const": "coverage_probe"},
          "fixture_path": {"type": "string", "minLength": 1},
          "fixture_sha256": {"$ref": "#/$defs/sha256"},
          "qualification_status": {"enum": ["qualified_measurement_fixture", "pending"]},
          "admission_status": {"enum": ["active", "retired_but_preserved", "pending"]},
          "expected_coverage_status": {"enum": ["complete", "partial", "unknown"]},
          "introduced_at": {"type": "string", "format": "date"},
          "supersedes": {"type": ["string", "null"]},
          "retired_reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
