{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cycle-cost-observations-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_id", "extractor_version", "source_summary", "runs", "policy"],
  "properties": {
    "schema_version": {"const": 1},
    "schema_id": {"const": "cycle-cost-observations-v1"},
    "extractor_version": {"const": "acp-cycle-cost-v0.1"},
    "source_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_count", "exact_linked_run_count", "arm_counts", "case_count", "case_ids", "model_identifier", "reasoning_effort", "subject_commit", "codex_version", "private_summary_sha256", "private_source_inventory_sha256"],
      "properties": {
        "run_count": {"type": "integer", "minimum": 1},
        "exact_linked_run_count": {"type": "integer", "minimum": 1},
        "arm_counts": {"type": "object", "additionalProperties": false, "required": ["off", "on"], "properties": {"off": {"type": "integer", "minimum": 1}, "on": {"type": "integer", "minimum": 1}}},
        "case_count": {"type": "integer", "minimum": 1},
        "case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "model_identifier": {"type": "string"}, "reasoning_effort": {"type": "string"}, "subject_commit": {"type": "string"}, "codex_version": {"type": "string"},
        "private_summary_sha256": {"$ref": "#/$defs/hash"}, "private_source_inventory_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/run"}},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_id_linkage_only", "timestamp_linkage", "private_bodies_emitted", "absolute_paths_emitted", "raw_session_identifiers_emitted", "online_effect"],
      "properties": {
        "exact_id_linkage_only": {"const": true}, "timestamp_linkage": {"const": false}, "private_bodies_emitted": {"const": false},
        "absolute_paths_emitted": {"const": false}, "raw_session_identifiers_emitted": {"const": false}, "online_effect": {"const": false}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0}, "cached_input_tokens": {"type": "integer", "minimum": 0}, "cache_write_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}, "reasoning_output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "cycle": {
      "type": "object", "additionalProperties": false, "required": ["ordinal", "cumulative_usage", "incremental_usage"],
      "properties": {"ordinal": {"type": "integer", "minimum": 1}, "cumulative_usage": {"$ref": "#/$defs/usage"}, "incremental_usage": {"$ref": "#/$defs/usage"}}
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["run_id_hash", "case_id", "arm", "cycle_count", "cycles", "source_pair_sha256"],
      "properties": {
        "run_id_hash": {"$ref": "#/$defs/hash"}, "case_id": {"type": "string"}, "arm": {"enum": ["off", "on"]},
        "cycle_count": {"type": "integer", "minimum": 1}, "cycles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cycle"}}, "source_pair_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
