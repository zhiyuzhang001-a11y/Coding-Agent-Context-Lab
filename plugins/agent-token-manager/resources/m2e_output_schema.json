{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "target_path",
    "target_symbol",
    "tests",
    "stop_reason"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked"]
    },
    "summary": {
      "type": "string"
    },
    "target_path": {
      "type": "string"
    },
    "target_symbol": {
      "type": "string"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_reason": {
      "type": "string",
      "enum": [
        "evidence_sufficient",
        "change_verified",
        "low_expected_gain",
        "budget_exhausted",
        "blocked"
      ]
    }
  }
}
